{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sinica 1845 revised public text 2",
  "type": "object",
  "required": [
    "schema",
    "privacy",
    "id",
    "title",
    "version",
    "source",
    "pages",
    "units"
  ],
  "properties": {
    "schema": {
      "const": "sinica1845-revised-text/2"
    },
    "privacy": {
      "const": "public"
    },
    "version": {
      "const": "0.2.0"
    },
    "pages": {
      "type": "array",
      "minItems": 497,
      "maxItems": 497,
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "source",
          "coverage_state",
          "uncertainties"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "object",
            "required": [
              "uri",
              "image_uri",
              "sha256",
              "width",
              "height"
            ]
          },
          "uncertainties": {
            "type": "array"
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "page_id",
          "order",
          "text",
          "layer",
          "role",
          "review_status",
          "bbox",
          "uncertainties",
          "gaps",
          "native_order",
          "projection_order"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "page_id": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": [
              "array",
              "null"
            ]
          },
          "native_order": {
            "type": [
              "number",
              "null"
            ]
          },
          "projection_order": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
